    "expo": "^58.0.11",
    "expo-status-bar": "~58.0.3",
    "firebase": "^12.9.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.83.2",
    "react-native-web": "^0.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@storybook/react-vite": "^10.6.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.2.0",
    "jest-expo": "^58.0.11",
    "storybook": "^10.6.2",
    "vite": "^7.3.7"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
