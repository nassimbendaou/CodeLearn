# Firebase web configuration. EXPO_PUBLIC_ values are bundled in the client.
# Do not place server secrets or admin credentials in this file.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Code-review AI (server only). Create a free Gemini API key in Google AI Studio,
# then place it in the server environment. Never prefix this variable with EXPO_PUBLIC_.
AI_REVIEW_PROVIDER=gemini
GEMINI_API_KEY=
